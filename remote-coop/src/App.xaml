<Application x:Class="DragonCrownRemoteCoop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <Style x:Key="BigButton" TargetType="Button">
      <Setter Property="Background" Value="#3A4048"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="10,10,10,10"/>
      <Setter Property="Margin" Value="4"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style x:Key="SmallButton" TargetType="Button" BasedOn="{StaticResource BigButton}">
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="FontWeight" Value="Normal"/>
      <Setter Property="Padding" Value="8,7,8,7"/>
    </Style>
    <Style x:Key="StatusText" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="Consolas"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="Foreground" Value="#D8E0E8"/>
      <Setter Property="Margin" Value="2,1,2,1"/>
    </Style>
  </Application.Resources>
</Application>
