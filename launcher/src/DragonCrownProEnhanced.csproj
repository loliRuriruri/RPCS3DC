<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <AssemblyName>DragonCrownProEnhanced</AssemblyName>
    <RootNamespace>DragonCrownProEnhanced</RootNamespace>
    <Version>1.0.0</Version>
    <Product>Dragon's Crown PRO Enhanced for RPCS3</Product>
    <AssemblyTitle>Dragon's Crown PRO Enhanced</AssemblyTitle>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Platforms>x64</Platforms>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <SatelliteResourceLanguages>en;ko</SatelliteResourceLanguages>
    <ApplicationIcon></ApplicationIcon>
  </PropertyGroup>

</Project>
