<Application x:Class="DragonCrownProEnhanced.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             >
  <Application.Resources>
    <Style TargetType="Button" x:Key="BigButton">
      <Setter Property="FontSize" Value="20"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="Background" Value="#2E4A6B"/>
      <Setter Property="Margin" Value="6"/>
      <Setter Property="Padding" Value="14"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Height" Value="86"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style TargetType="Button" x:Key="SmallButton">
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Foreground" Value="#E6E6E6"/>
      <Setter Property="Background" Value="#33383F"/>
      <Setter Property="Margin" Value="5"/>
      <Setter Property="Padding" Value="10,6"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
  </Application.Resources>
</Application>
