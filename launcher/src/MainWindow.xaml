<Window x:Class="DragonCrownProEnhanced.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dragon's Crown PRO Enhanced — RPCS3"
        Height="720" Width="760" MinHeight="640" MinWidth="700"
        Background="#1E2126" WindowStartupLocation="CenterScreen">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="170"/>
    </Grid.RowDefinitions>

    <!-- header -->
    <StackPanel Grid.Row="0">
      <TextBlock Text="DRAGON'S CROWN" FontSize="34" FontWeight="Bold" Foreground="#F2C14E"/>
      <TextBlock Text="PRO ENHANCED" FontSize="24" FontWeight="SemiBold" Foreground="#CFD8E3" Margin="0,-4,0,2"/>
      <TextBlock x:Name="TxtSubtitle" FontSize="12" Foreground="#8FA3B8"
                 Text="RPCS3 · Vulkan · 4K 300% · Borderless · VSync · ReShade Silent"/>
    </StackPanel>

    <!-- main buttons -->
    <Grid Grid.Row="1" Margin="0,12,0,6">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <Button Grid.Row="0" Grid.Column="0" x:Name="BtnPlay" Style="{StaticResource BigButton}" Click="BtnPlay_Click">
        <StackPanel>
          <TextBlock Text="PLAY" HorizontalAlignment="Center"/>
          <TextBlock Text="4K PRO · 300%" FontSize="12" FontWeight="Normal" HorizontalAlignment="Center" Foreground="#BFD4EA"/>
        </StackPanel>
      </Button>
      <Button Grid.Row="0" Grid.Column="1" x:Name="BtnProMax" Style="{StaticResource BigButton}" Background="#5A3E6B" Click="BtnProMax_Click">
        <StackPanel>
          <TextBlock Text="PRO MAX" HorizontalAlignment="Center"/>
          <TextBlock Text="5K SSAA · 400%" FontSize="12" FontWeight="Normal" HorizontalAlignment="Center" Foreground="#DCC7EA"/>
        </StackPanel>
      </Button>
      <Button Grid.Row="1" Grid.Column="0" x:Name="BtnNetplay" Style="{StaticResource BigButton}" Background="#2F5D50" Click="BtnNetplay_Click">
        <StackPanel>
          <TextBlock Text="NETPLAY" HorizontalAlignment="Center"/>
          <TextBlock Text="RPCN · 치트 OFF" FontSize="12" FontWeight="Normal" HorizontalAlignment="Center" Foreground="#C7E6DA"/>
        </StackPanel>
      </Button>
      <Button Grid.Row="1" Grid.Column="1" x:Name="BtnCheat" Style="{StaticResource BigButton}" Background="#6B4A2E" Click="BtnCheat_Click">
        <StackPanel>
          <TextBlock Text="CHEAT OFFLINE" HorizontalAlignment="Center"/>
          <TextBlock Text="RPCN OFF · Save 자동 백업" FontSize="12" FontWeight="Normal" HorizontalAlignment="Center" Foreground="#EAD9C7"/>
        </StackPanel>
      </Button>
    </Grid>

    <!-- status -->
    <Border Grid.Row="2" Background="#23262C" CornerRadius="6" Padding="12" Margin="0,6">
      <StackPanel>
        <TextBlock Text="STATUS" FontSize="12" Foreground="#7F8C9B" Margin="0,0,0,6"/>
        <TextBlock x:Name="TxtStatus" FontFamily="Consolas" FontSize="13" Foreground="#D8E0E8" TextWrapping="Wrap"/>
      </StackPanel>
    </Border>

    <!-- bottom buttons -->
    <UniformGrid Grid.Row="3" Rows="1" Columns="4">
      <Button x:Name="BtnSaves" Style="{StaticResource SmallButton}" Content="SAVES" Click="BtnSaves_Click"/>
      <Button x:Name="BtnGraphics" Style="{StaticResource SmallButton}" Content="GRAPHICS" Click="BtnGraphics_Click"/>
      <Button x:Name="BtnSettings" Style="{StaticResource SmallButton}" Content="SETTINGS" Click="BtnSettings_Click"/>
      <Button x:Name="BtnMaintenance" Style="{StaticResource SmallButton}" Content="MAINTENANCE" Click="BtnMaintenance_Click"/>
    </UniformGrid>

    <TextBlock Grid.Row="4" x:Name="TxtRoot" FontSize="11" Foreground="#6E7B8A" Margin="6,2,0,4"/>

    <!-- log -->
    <Border Grid.Row="5" Background="#15181C" CornerRadius="6" Padding="8">
      <TextBox x:Name="TxtLog" Background="Transparent" BorderThickness="0" Foreground="#9FD3A0"
               FontFamily="Consolas" FontSize="11" IsReadOnly="True" VerticalScrollBarVisibility="Auto"
               TextWrapping="Wrap"/>
    </Border>
  </Grid>
</Window>
