<Window x:Class="DragonCrownProEnhanced.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dragon's Crown PC Edition — RPCS3 (Phase 1 RC)"
        Height="780" Width="820" MinHeight="700" MinWidth="760"
        Background="#1E2126" WindowStartupLocation="CenterScreen">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="150"/>
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0">
      <TextBlock Text="DRAGON'S CROWN" FontSize="32" FontWeight="Bold" Foreground="#F2C14E"/>
      <TextBlock Text="PC EDITION" FontSize="20" FontWeight="SemiBold" Foreground="#CFD8E3" Margin="0,-6,0,2"/>
      <TextBlock x:Name="TxtSubtitle" FontSize="12" Foreground="#8FA3B8"
                 Text="RPCS3 · Vulkan · 4K · Borderless · 60fps · ReShade Silent · Multiplayer"/>
    </StackPanel>

    <!-- PLAY -->
    <Border Grid.Row="1" Background="#23262C" CornerRadius="6" Padding="10" Margin="0,10,0,6">
      <StackPanel>
        <TextBlock Text="PLAY" FontSize="13" Foreground="#7F8C9B" Margin="2,0,0,4"/>
        <UniformGrid Rows="1" Columns="2">
          <Button x:Name="BtnStandard" Style="{StaticResource BigButton}" Click="BtnStandard_Click">
            <StackPanel>
              <TextBlock Text="Standard" HorizontalAlignment="Center"/>
              <TextBlock x:Name="TxtStandardSub" Text="4K 300% · AF 16x · ReShade 없음" FontSize="11" FontWeight="Normal"
                         HorizontalAlignment="Center" Foreground="#BFD4EA"/>
            </StackPanel>
          </Button>
          <Button x:Name="BtnProEnhanced" Style="{StaticResource BigButton}" Background="#5A3E6B" Click="BtnProEnhanced_Click">
            <StackPanel>
              <TextBlock Text="Pro Enhanced" HorizontalAlignment="Center"/>
              <TextBlock x:Name="TxtProSub" Text="4K 300% + ReShade (선명도/색감)" FontSize="11" FontWeight="Normal"
                         HorizontalAlignment="Center" Foreground="#DCC7EA"/>
            </StackPanel>
          </Button>
        </UniformGrid>
      </StackPanel>
    </Border>

    <!-- MULTIPLAYER -->
    <Border Grid.Row="2" Background="#23262C" CornerRadius="6" Padding="10" Margin="0,4">
      <StackPanel>
        <TextBlock Text="MULTIPLAYER" FontSize="13" Foreground="#7F8C9B" Margin="2,0,0,4"/>
        <UniformGrid Rows="1" Columns="3">
          <Button x:Name="BtnLocal" Style="{StaticResource SmallButton}" Height="54" Click="BtnLocal_Click">
            <StackPanel><TextBlock Text="Local" HorizontalAlignment="Center" FontSize="15"/>
              <TextBlock Text="1P / 2P 같은 PC" FontSize="10" HorizontalAlignment="Center" Foreground="#9FB3C8"/></StackPanel>
          </Button>
          <Button x:Name="BtnRemote" Style="{StaticResource SmallButton}" Height="54" Background="#2F5D50" Click="BtnRemote_Click">
            <StackPanel><TextBlock Text="Remote Co-op" HorizontalAlignment="Center" FontSize="15"/>
              <TextBlock Text="Sunshine + Moonlight" FontSize="10" HorizontalAlignment="Center" Foreground="#B7DCCB"/></StackPanel>
          </Button>
          <Button x:Name="BtnRpcn" Style="{StaticResource SmallButton}" Height="54" Background="#5D4A2F" Click="BtnRpcn_Click">
            <StackPanel><TextBlock Text="RPCN Online" HorizontalAlignment="Center" FontSize="15"/>
              <TextBlock Text="각자 RPCS3 + 세이브" FontSize="10" HorizontalAlignment="Center" Foreground="#E0D3B7"/></StackPanel>
          </Button>
        </UniformGrid>
      </StackPanel>
    </Border>

    <!-- SETTINGS / TOOLS -->
    <Grid Grid.Row="3" Margin="0,4">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Border Grid.Column="0" Background="#23262C" CornerRadius="6" Padding="10" Margin="0,0,4,0">
        <StackPanel>
          <TextBlock Text="SETTINGS" FontSize="13" Foreground="#7F8C9B" Margin="2,0,0,4"/>
          <UniformGrid Rows="2" Columns="2">
            <Button Style="{StaticResource SmallButton}" Content="Graphics" Click="BtnGraphics_Click"/>
            <Button Style="{StaticResource SmallButton}" Content="Controller" Click="BtnController_Click"/>
            <Button Style="{StaticResource SmallButton}" Content="Network" Click="BtnNetwork_Click"/>
            <Button Style="{StaticResource SmallButton}" Content="Advanced" Click="BtnAdvanced_Click"/>
          </UniformGrid>
        </StackPanel>
      </Border>
      <Border Grid.Column="1" Background="#23262C" CornerRadius="6" Padding="10" Margin="4,0,0,0">
        <StackPanel>
          <TextBlock Text="TOOLS" FontSize="13" Foreground="#7F8C9B" Margin="2,0,0,4"/>
          <UniformGrid Rows="2" Columns="2">
            <Button Style="{StaticResource SmallButton}" Content="Diagnostics" Click="BtnDiagnostics_Click"/>
            <Button Style="{StaticResource SmallButton}" Content="Reset RPCS3 Settings" Click="BtnReset_Click"/>
            <Button Style="{StaticResource SmallButton}" Content="Backup / Restore" Click="BtnBackup_Click"/>
            <Button Style="{StaticResource SmallButton}" Content="KnownGood / Logs" Click="BtnMaint_Click"/>
          </UniformGrid>
        </StackPanel>
      </Border>
    </Grid>

    <!-- status -->
    <Border Grid.Row="4" Background="#1B1E22" CornerRadius="6" Padding="12" Margin="0,6">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <TextBlock x:Name="TxtStatus" FontFamily="Consolas" FontSize="12.5" Foreground="#D8E0E8" TextWrapping="Wrap"/>
      </ScrollViewer>
    </Border>

    <TextBlock Grid.Row="5" x:Name="TxtRoot" FontSize="11" Foreground="#6E7B8A" Margin="6,2,0,4"/>

    <Border Grid.Row="6" Background="#15181C" CornerRadius="6" Padding="8">
      <TextBox x:Name="TxtLog" Background="Transparent" BorderThickness="0" Foreground="#9FD3A0"
               FontFamily="Consolas" FontSize="11" IsReadOnly="True" VerticalScrollBarVisibility="Auto"
               TextWrapping="Wrap"/>
    </Border>
  </Grid>
</Window>
