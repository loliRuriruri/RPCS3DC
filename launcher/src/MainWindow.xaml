<Window x:Class="DragonCrownProEnhanced.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dragon's Crown PC Edition — RPCS3 (Phase 1 RC)"
        Height="800" Width="1200" MinHeight="720" MinWidth="1040"
        Background="#0B0D12" WindowStartupLocation="CenterScreen">
  <Grid>
    <!-- background: deep gradient + faint hero watermark -->
    <Grid.Background>
      <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#0B0D12" Offset="0"/>
        <GradientStop Color="#131826" Offset="0.55"/>
        <GradientStop Color="#090B0F" Offset="1"/>
      </LinearGradientBrush>
    </Grid.Background>
    <Image Source="Assets/hero.png" HorizontalAlignment="Right" VerticalAlignment="Bottom"
           Width="640" Opacity="0.07" Stretch="Uniform" IsHitTestVisible="False" Margin="0,0,-70,-90"/>

    <Grid Margin="16">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="140"/>
      </Grid.RowDefinitions>

      <!-- header -->
      <StackPanel Grid.Row="0" Orientation="Horizontal">
        <Border Width="62" Height="62" CornerRadius="31" BorderBrush="{StaticResource Gold}" BorderThickness="1" Margin="0,0,14,0">
          <Border.Background>
            <ImageBrush ImageSource="Assets/hero.png" Stretch="UniformToFill"/>
          </Border.Background>
        </Border>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="DRAGON'S CROWN" Style="{StaticResource TitleText}"/>
          <TextBlock Text="PC EDITION" Style="{StaticResource SubtitleText}"/>
          <TextBlock x:Name="TxtSubtitle" FontSize="11.5" Foreground="{StaticResource ParchmentDim}"
                     Text="RPCS3 · Vulkan · 4K · Borderless · 60fps · ReShade Silent · Multiplayer"/>
        </StackPanel>
      </StackPanel>

      <!-- PLAY -->
      <Border Grid.Row="1" Style="{StaticResource PanelBorder}">
        <StackPanel>
          <TextBlock Text="PLAY" Style="{StaticResource SectionTitle}"/>
          <UniformGrid Rows="1" Columns="2">
            <Button x:Name="BtnStandard" Style="{StaticResource PrimaryButton}" Click="BtnStandard_Click">
              <StackPanel>
                <TextBlock Text="Standard" HorizontalAlignment="Center"/>
                <TextBlock x:Name="TxtStandardSub" Text="4K 300% · AF 16x · ReShade 없음" FontSize="11"
                           FontWeight="Normal" HorizontalAlignment="Center" Foreground="#E8C9A0"/>
              </StackPanel>
            </Button>
            <Button x:Name="BtnProEnhanced" Style="{StaticResource BigButton}" Background="#38294A" Click="BtnProEnhanced_Click">
              <StackPanel>
                <TextBlock Text="Pro Enhanced" HorizontalAlignment="Center"/>
                <TextBlock x:Name="TxtProSub" Text="4K 300% + ReShade (선명도/색감)" FontSize="11" FontWeight="Normal"
                           HorizontalAlignment="Center" Foreground="#CDB9E0"/>
              </StackPanel>
            </Button>
          </UniformGrid>
        </StackPanel>
      </Border>

      <!-- MULTIPLAYER -->
      <Border Grid.Row="2" Style="{StaticResource PanelBorder}">
        <StackPanel>
          <TextBlock Text="MULTIPLAYER" Style="{StaticResource SectionTitle}"/>
          <UniformGrid Rows="1" Columns="3">
            <Button x:Name="BtnLocal" Style="{StaticResource SmallButton}" Height="56" Click="BtnLocal_Click">
              <StackPanel><TextBlock Text="Local" HorizontalAlignment="Center" FontSize="15"/>
                <TextBlock Text="1P / 2P 같은 PC" FontSize="10" HorizontalAlignment="Center" Foreground="#9C947F"/></StackPanel>
            </Button>
            <Button x:Name="BtnRemote" Style="{StaticResource SmallButton}" Height="56" Background="#22402F" Click="BtnRemote_Click">
              <StackPanel><TextBlock Text="Remote Co-op" HorizontalAlignment="Center" FontSize="15"/>
                <TextBlock Text="Sunshine + Moonlight" FontSize="10" HorizontalAlignment="Center" Foreground="#A8CDB6"/></StackPanel>
            </Button>
            <Button x:Name="BtnRpcn" Style="{StaticResource SmallButton}" Height="56" Background="#43351F" Click="BtnRpcn_Click">
              <StackPanel><TextBlock Text="RPCN Online" HorizontalAlignment="Center" FontSize="15"/>
                <TextBlock Text="각자 RPCS3 + 세이브" FontSize="10" HorizontalAlignment="Center" Foreground="#D8C49A"/></StackPanel>
            </Button>
          </UniformGrid>
        </StackPanel>
      </Border>

      <!-- SETTINGS / TOOLS / RPCS3 -->
      <Grid Grid.Row="3" Margin="0,4,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Style="{StaticResource PanelBorder}" Margin="0,0,4,0">
          <StackPanel>
            <TextBlock Text="SETTINGS" Style="{StaticResource SectionTitle}"/>
            <UniformGrid Rows="2" Columns="2">
              <Button Style="{StaticResource SmallButton}" Content="Graphics" Click="BtnGraphics_Click"/>
              <Button Style="{StaticResource SmallButton}" Content="Controller" Click="BtnController_Click"/>
              <Button Style="{StaticResource SmallButton}" Content="Network" Click="BtnNetwork_Click"/>
              <Button Style="{StaticResource SmallButton}" Content="Advanced" Click="BtnAdvanced_Click"/>
            </UniformGrid>
          </StackPanel>
        </Border>
        <Border Grid.Column="1" Style="{StaticResource PanelBorder}" Margin="4,0,4,0">
          <StackPanel>
            <TextBlock Text="TOOLS" Style="{StaticResource SectionTitle}"/>
            <UniformGrid Rows="2" Columns="2">
              <Button Style="{StaticResource SmallButton}" Content="Diagnostics" Click="BtnDiagnostics_Click"/>
              <Button Style="{StaticResource SmallButton}" Content="Reset RPCS3 Settings" Click="BtnReset_Click"/>
              <Button Style="{StaticResource SmallButton}" Content="Backup / Restore" Click="BtnBackup_Click"/>
              <Button Style="{StaticResource SmallButton}" Content="KnownGood / Logs" Click="BtnMaint_Click"/>
            </UniformGrid>
          </StackPanel>
        </Border>
        <Border Grid.Column="2" Style="{StaticResource PanelBorder}" Margin="4,0,0,0">
          <StackPanel>
            <TextBlock Text="RPCS3 설정" Style="{StaticResource SectionTitle}"/>
            <UniformGrid Rows="2" Columns="2">
              <Button Style="{StaticResource SmallButton}" Content="패드 / 컨트롤러" Click="BtnRpcs3Controller_Click"/>
              <Button Style="{StaticResource SmallButton}" Content="RPCN 계정" Click="BtnRpcs3Rpcn_Click"/>
              <Button Style="{StaticResource SmallButton}" Content="전체 설정" Click="BtnRpcs3General_Click"/>
              <Button Style="{StaticResource SmallButton}" Content="RPCS3 메인 창" Click="BtnRpcs3Open_Click"/>
            </UniformGrid>
            <Button Style="{StaticResource SmallButton}" Content="상태 새로고침" Click="BtnRpcs3Refresh_Click"/>
          </StackPanel>
        </Border>
      </Grid>

      <!-- status -->
      <Border Grid.Row="4" Style="{StaticResource PanelBorder}" Background="#0F131A">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <TextBlock x:Name="TxtStatus" Style="{StaticResource StatusText}"/>
        </ScrollViewer>
      </Border>

      <TextBlock Grid.Row="5" x:Name="TxtRoot" FontSize="11" Foreground="#7C7460" Margin="6,4,0,4"/>

      <Border Grid.Row="6" Style="{StaticResource PanelBorder}" Background="#0A0C10" Padding="8">
        <TextBox x:Name="TxtLog" Style="{StaticResource LogText}"/>
      </Border>
    </Grid>
  </Grid>
</Window>
